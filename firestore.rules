rules_version = '2';
// Version 1.0.2
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: stocks
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required, 1-100 chars)
    //   - gsm: number (optional, positive)
    //   - size: string (optional, 1-50 chars)
    //   - quantity: number (required, non-negative)
    //   - type: string (required, enum: ['paper', 'board', 'ink', 'plate'])
    //   - lastUpdated: number (required, timestamp)
    //
    // Collection: jobs
    // Document ID: auto-generated
    // Fields:
    //   - clientName: string (required, 1-100 chars)
    //   - jobDescription: string (required, 1-1000 chars)
    //   - date: number (required, timestamp)
    //   - items: list (required, max 50 items)
    //     - stockId: string
    //     - quantityUsed: number (positive)
    //
    // Collection: inkUsage
    // Document ID: auto-generated
    // Fields:
    //   - inkId: string
    //   - date: number (timestamp)
    //   - weight: number
    //   - count: number
    //   - quantity: number
    //   - stockType: string
    //   - notes: string (optional)
    //
    // Collection: stockHistory
    // Document ID: auto-generated
    // Fields:
    //   - stockId: string
    //   - date: number (timestamp)
    //   - type: string (enum: ['addition', 'usage'])
    //   - quantity: number
    //   - previousQuantity: number
    //   - newQuantity: number
    //   - notes: string (optional)
    //   - jobId: string (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
         (request.auth.token.email == "subhanshuraj9@gmail.com" && request.auth.token.email_verified == true) ||
         (request.auth.token.email == "admin@printstock.local"));
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isValidStock(data) {
      return hasRequiredFields(data, ['name', 'quantity', 'type']) &&
             hasOnlyAllowedFields(data, ['id', 'name', 'gsm', 'size', 'quantity', 'type', 'lastUpdated', 'inkContainers', 'defaultRate', 'paperType', 'unit', 'brand', 'millName', 'shade', 'notes']) &&
             data.name is string && data.name.size() >= 1 &&
             (!('id' in data) || data.id == null || data.id is string) &&
             (!('gsm' in data) || data.gsm == null || data.gsm == "" || data.gsm is number || data.gsm is string) &&
             (!('size' in data) || data.size == null || data.size is string) &&
             data.quantity is number &&
             data.type in ['paper', 'board', 'ink', 'plate'] &&
             (!('inkContainers' in data) || (data.inkContainers is list)) &&
             (!('lastUpdated' in data) || data.lastUpdated is number) &&
             (!('defaultRate' in data) || data.defaultRate == null || data.defaultRate == "" || data.defaultRate is number || data.defaultRate is string) &&
             (!('paperType' in data) || data.paperType == null || data.paperType is string) &&
             (!('unit' in data) || data.unit == null || data.unit is string) &&
             (!('brand' in data) || data.brand == null || data.brand is string) &&
             (!('millName' in data) || data.millName == null || data.millName is string) &&
             (!('shade' in data) || data.shade == null || data.shade is string) &&
             (!('notes' in data) || data.notes == null || data.notes is string);
    }

    function isValidJob(data) {
      return hasRequiredFields(data, ['clientName', 'jobDescription', 'date', 'items']) &&
             hasOnlyAllowedFields(data, ['jobNo', 'clientName', 'jobDescription', 'date', 'items', 'platesUsed', 'processCharges', 'orderedQuantity', 'dispatches', 'dispatchStatus', 'isJoint', 'jointRef', 'jointJobType', 'sharedRunId', 'jointParentId', 'previewImage', 'lamination', 'isRepeat', 'repeatRef', 'paperBillingMethod', 'paperBillingRate', 'paperBillingAmount', 'additionalCharges']) &&
             data.clientName is string && data.clientName.size() >= 1 &&
             data.jobDescription is string && data.jobDescription.size() >= 1 &&
             data.date is number &&
             data.items is list &&
             (!('jobNo' in data) || data.jobNo is number) &&
             (!('platesUsed' in data) || (data.platesUsed is list)) &&
             (!('processCharges' in data) || (data.processCharges is list)) &&
             (!('orderedQuantity' in data) || data.orderedQuantity == null || (data.orderedQuantity is number && data.orderedQuantity >= 0)) &&
             (!('dispatches' in data) || (data.dispatches is list)) &&
             (!('dispatchStatus' in data) || data.dispatchStatus == null || (data.dispatchStatus in ['pending', 'partial', 'completed'])) &&
             (!('isJoint' in data) || data.isJoint == null || (data.isJoint is bool)) &&
             (!('jointRef' in data) || data.jointRef == null || (data.jointRef is string)) &&
             (!('jointJobType' in data) || data.jointJobType == null || (data.jointJobType is string)) &&
             (!('sharedRunId' in data) || data.sharedRunId == null || (data.sharedRunId is string)) &&
             (!('jointParentId' in data) || data.jointParentId == null || (data.jointParentId is string)) &&
             (!('isRepeat' in data) || data.isRepeat == null || (data.isRepeat is bool)) &&
             (!('repeatRef' in data) || data.repeatRef == null || (data.repeatRef is string)) &&
             (!('previewImage' in data) || data.previewImage == null || (data.previewImage is string)) &&
             (!('lamination' in data) || data.lamination == null || (data.lamination is map)) &&
             (!('paperBillingMethod' in data) || data.paperBillingMethod == null || data.paperBillingMethod in ['100sheets', 'gross', 'ream', 'custom', '']) &&
             (!('paperBillingRate' in data) || data.paperBillingRate == null || data.paperBillingRate is number) &&
             (!('paperBillingAmount' in data) || data.paperBillingAmount == null || data.paperBillingAmount is number) &&
             (!('additionalCharges' in data) || data.additionalCharges == null || data.additionalCharges is number);
    }

    function isValidPayment(data) {
      return hasRequiredFields(data, ['clientName', 'amount', 'date']) &&
             hasOnlyAllowedFields(data, ['clientName', 'amount', 'date', 'notes']) &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 100 &&
             data.amount is number && data.amount > 0 &&
             data.date is number &&
             (!('notes' in data) || (data.notes is string));
    }

    function isValidInkUsage(data) {
      return hasRequiredFields(data, ['inkId', 'date', 'quantity', 'stockType']) &&
             hasOnlyAllowedFields(data, ['inkId', 'date', 'weight', 'count', 'quantity', 'stockType', 'notes']) &&
             data.inkId is string &&
             data.date is number &&
             data.quantity is number &&
             data.stockType is string &&
             (!('weight' in data) || data.weight == null || (data.weight is number && data.weight > 0)) &&
             (!('count' in data) || data.count == null || (data.count is number && data.count > 0)) &&
             (!('notes' in data) || (data.notes is string));
    }

    function isValidStockHistory(data) {
      return hasRequiredFields(data, ['stockId', 'date', 'type', 'quantity', 'previousQuantity', 'newQuantity']) &&
             hasOnlyAllowedFields(data, ['stockId', 'date', 'type', 'quantity', 'previousQuantity', 'newQuantity', 'notes', 'purchaseRate', 'supplier', 'invoiceNo', 'jobId']) &&
             data.stockId is string &&
             data.date is number &&
             data.type in ['addition', 'usage'] &&
             data.quantity is number &&
             data.previousQuantity is number &&
             data.newQuantity is number &&
             (!('notes' in data) || (data.notes is string)) &&
             (!('purchaseRate' in data) || (data.purchaseRate is number && data.purchaseRate >= 0)) &&
             (!('supplier' in data) || (data.supplier is string)) &&
             (!('invoiceNo' in data) || (data.invoiceNo is string)) &&
             (!('jobId' in data) || (data.jobId is string));
    }

    function isValidPaperSection(data) {
      return hasRequiredFields(data, ['name', 'createdAt']) &&
             hasOnlyAllowedFields(data, ['name', 'createdAt']) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.createdAt is number;
    }

    function isValidBoardSection(data) {
      return hasRequiredFields(data, ['name', 'createdAt']) &&
             hasOnlyAllowedFields(data, ['name', 'createdAt']) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.createdAt is number;
    }

    function isValidJointRun(data) {
      return hasRequiredFields(data, ['sharedRunId', 'paper', 'totalSheetsUsed', 'wastageSheets', 'sharedPlates', 'linkedJobs']) &&
             data.sharedRunId is string &&
             data.paper is map &&
             data.totalSheetsUsed is number &&
             data.wastageSheets is number &&
             data.sharedPlates is list &&
             data.linkedJobs is list;
    }

    function isValidJointRunAuditLog(data) {
      return hasRequiredFields(data, ['sharedRunId', 'userEmail', 'changedField', 'oldValue', 'newValue', 'affectedJobs', 'timestamp']) &&
             data.sharedRunId is string &&
             data.userEmail is string &&
             data.changedField is string &&
             data.oldValue is string &&
             data.newValue is string &&
             data.affectedJobs is list &&
             data.timestamp is number;
    }

    function isValidPartyOpeningBalance(data) {
      return hasRequiredFields(data, ['clientName', 'openingBalance']) &&
             hasOnlyAllowedFields(data, ['clientName', 'openingBalance', 'lastUpdated']) &&
             data.clientName is string && data.clientName.size() >= 1 &&
             data.openingBalance is number &&
             (!('lastUpdated' in data) || data.lastUpdated is number);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /stocks/{stockId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidStock(request.resource.data);
      allow update: if isAuthenticated() && isValidStock(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidJob(request.resource.data);
      allow update: if isAuthenticated() && isValidJob(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /inkUsage/{usageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidInkUsage(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /stockHistory/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidStockHistory(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPayment(request.resource.data);
      allow update: if isAuthenticated() && isValidPayment(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /paperSections/{sectionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPaperSection(request.resource.data);
      allow update: if isAuthenticated() && isValidPaperSection(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /boardSections/{sectionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidBoardSection(request.resource.data);
      allow update: if isAuthenticated() && isValidBoardSection(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /jointRuns/{sharedRunId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidJointRun(request.resource.data);
      allow update: if isAuthenticated() && isValidJointRun(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /jointRunAuditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidJointRunAuditLog(request.resource.data);
      allow update: if isAuthenticated() && isValidJointRunAuditLog(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /partyOpeningBalances/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPartyOpeningBalance(request.resource.data);
      allow update: if isAuthenticated() && isValidPartyOpeningBalance(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /test/{testId} {
      allow read: if true;
    }
  }
}

{
  "entities": {
    "StockItem": {
      "title": "Stock Item",
      "description": "Represents a paper, board, ink, or plate stock in the printing press.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the stock item" },
        "gsm": { "type": "number", "description": "Grams per square meter (if paper/board)" },
        "size": { "type": "string", "description": "Dimensions or specifications of the stock item" },
        "quantity": { "type": "number", "description": "Total units available in stock" },
        "type": { "type": "string", "enum": ["paper", "board", "ink", "plate"], "description": "Category of the stock" },
        "paperType": { "type": "string", "description": "Sub-category / Specific brand or section of paper" },
        "lastUpdated": { "type": "number", "description": "Timestamp of last update" },
        "defaultRate": { "type": "number", "description": "Suggested charge per unit/sheet for billing" },
        "unit": { "type": "string", "description": "Inventory unit (e.g., Sheets, Pkts)" },
        "brand": { "type": "string", "description": "Brand of the stock item" },
        "millName": { "type": "string", "description": "Mill where the stock item was manufactured" },
        "shade": { "type": "string", "description": "Shade of paper/board (e.g., Blush Pink, Natural)" },
        "notes": { "type": "string", "description": "Additional notes about this stock item" }
      },
      "required": ["name", "quantity", "type", "lastUpdated"]
    },
    "Job": {
      "title": "Printing Job",
      "description": "Represents a printing job for a client, tracking papers, rates, plates and combination references.",
      "type": "object",
      "properties": {
        "clientName": { "type": "string", "description": "Name of the client" },
        "jobDescription": { "type": "string", "description": "Details of the job" },
        "date": { "type": "number", "description": "Timestamp of when the job was created" },
        "items": {
          "type": "array",
          "description": "List of paper stocks used in this job",
          "items": {
            "type": "object",
            "properties": {
              "stockId": { "type": "string" },
              "quantityUsed": { "type": "number", "description": "Actual Sheets Consumed" },
              "rate": { "type": "number" },
              "ups": { "type": "number", "description": "Matter Per Sheet (Ups)" },
              "autoCalculate": { "type": "boolean", "description": "Whether sheets required is auto-calculated" },
              "calculatedSheets": { "type": "number", "description": "Calculated Sheets Required" },
              "isJoint": { "type": "boolean", "description": "If true: joint paper, no stock deduction! Shared across parties/jobs" },
              "paperRef": { "type": "string", "description": "Reference of joint paper to link jobs" }
            },
            "required": ["stockId", "quantityUsed"]
          }
        },
        "platesUsed": {
          "type": "array",
          "description": "Plates assigned to this job, with shared/joint combinations tracking",
          "items": {
            "type": "object",
            "properties": {
              "plateId": { "type": "string" },
              "count": { "type": "number" },
              "isJoint": { "type": "boolean" },
              "plateRef": { "type": "string" },
              "rate": { "type": "number" }
            },
            "required": ["plateId", "count"]
          }
        },
        "processCharges": {
          "type": "array",
          "description": "Process-wise custom charges (e.g. cutting, folding, binding, UV, lamination, etc.)",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "amount": { "type": "number" },
              "notes": { "type": "string" }
            },
            "required": ["id", "name", "amount"]
          }
        },
        "orderedQuantity": {
          "type": "number",
          "description": "Total bulk ordered quantity of physical finished items"
        },
        "dispatches": {
          "type": "array",
          "description": "Shipment/collection records of products to client, to track bulk/partial completions",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "date": { "type": "number" },
              "quantityShipped": { "type": "number" },
              "receiverName": { "type": "string" },
              "notes": { "type": "string" }
            },
            "required": ["id", "date", "quantityShipped"]
          }
        },
        "dispatchStatus": {
          "type": "string",
          "enum": ["pending", "partial", "completed"],
          "description": "Overall dispatch delivery tracking status"
        },
        "isJoint": {
          "type": "boolean",
          "description": "Whether this job shares/combines printing materials"
        },
        "lamination": {
          "type": "object",
          "properties": {
            "halfEnabled": { "type": "boolean" },
            "halfQty": { "type": "number" },
            "halfRate": { "type": "number" },
            "fullEnabled": { "type": "boolean" },
            "fullQty": { "type": "number" },
            "fullRate": { "type": "number" }
          }
        },
        "jointRef": {
          "type": "string",
          "description": "Sharing/combination reference string"
        },
        "previewImage": {
          "type": "string",
          "description": "Base64 representation of job artwork/proof image for preview"
        },
        "paperBillingMethod": {
          "type": "string",
          "enum": ["100sheets", "gross", "ream", "custom", ""],
          "description": "Type of paper billing applied to customers"
        },
        "paperBillingRate": {
          "type": "number",
          "description": "Paper billing rate value"
        },
        "paperBillingAmount": {
          "type": "number",
          "description": "Automatically computed or manually entered customer paper billing amount"
        }
      },
      "required": ["clientName", "jobDescription", "date", "items"]
    },
    "Payment": {
      "title": "Client Payment",
      "description": "Represents a payment received from a client/party for balancing ledgers.",
      "type": "object",
      "properties": {
        "clientName": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["clientName", "amount", "date"]
    },
    "PaperSection": {
      "title": "Paper Section",
      "description": "Represents a category division of paper stocks.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the paper section" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" }
      },
      "required": ["name", "createdAt"]
    },
    "BoardSection": {
      "title": "Board Section",
      "description": "Represents a category division of board stocks.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the board section" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" }
      },
      "required": ["name", "createdAt"]
    },
    "JointRun": {
      "title": "Joint Production Run",
      "description": "Represents a combined manufacture or production run sharing papers and plates.",
      "type": "object",
      "properties": {
        "sharedRunId": { "type": "string" },
        "paper": {
          "type": "object",
          "properties": {
            "stockId": { "type": "string" },
            "paperSize": { "type": "string" },
            "paperSection": { "type": "string" },
            "paperNotes": { "type": "string" },
            "productionNotes": { "type": "string" },
            "paperRate": { "type": "number" }
          },
          "required": ["stockId"]
        },
        "totalSheetsUsed": { "type": "number" },
        "wastageSheets": { "type": "number" },
        "sharedPlates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "plateId": { "type": "string" },
              "count": { "type": "number" },
              "rate": { "type": "number" },
              "isJoint": { "type": "boolean" },
              "isJointRef": { "type": "boolean" },
              "plateRef": { "type": "string" }
            },
            "required": ["plateId", "count"]
          }
        },
        "linkedJobs": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["sharedRunId", "paper", "totalSheetsUsed", "wastageSheets", "sharedPlates", "linkedJobs"]
    },
    "JointRunAuditLog": {
      "title": "Joint Run Audit Log",
      "description": "Tracks changes to shared run data for compliance and synchronization safeguards.",
      "type": "object",
      "properties": {
        "sharedRunId": { "type": "string" },
        "userEmail": { "type": "string" },
        "changedField": { "type": "string" },
        "oldValue": { "type": "string" },
        "newValue": { "type": "string" },
        "affectedJobs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timestamp": { "type": "number" }
      },
      "required": ["sharedRunId", "userEmail", "changedField", "oldValue", "newValue", "affectedJobs", "timestamp"]
    }
  },
  "firestore": {
    "/stocks/{stockId}": {
      "schema": "StockItem",
      "description": "Collection of stock materials (paper, board, ink, and plates)"
    },
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Collection of jobs containing clients, items, and sheet/plate usages and billing rates"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Collection of payments received from client parties"
    },
    "/paperSections/{sectionId}": {
      "schema": "PaperSection",
      "description": "Collection of custom paper sub-categories / sections"
    },
    "/boardSections/{sectionId}": {
      "schema": "BoardSection",
      "description": "Collection of custom board sub-categories / sections"
    },
    "/jointRuns/{sharedRunId}": {
      "schema": "JointRun",
      "description": "Collection of shared joint runs"
    },
    "/jointRunAuditLogs/{logId}": {
      "schema": "JointRunAuditLog",
      "description": "Collection of joint run sync modifications audit history"
    }
  }
}
